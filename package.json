{
  "name": "vaybik-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "NODE_ENV=production next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx src/worker/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "seed:e2e": "tsx scripts/seed-e2e-user.ts",
    "seed:services": "tsx scripts/seed-services.ts",
    "vault:rotate": "tsx scripts/vault-rotate.ts",
    "backup:now": "tsx scripts/backup-now.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "deploy:prod": "bash scripts/deploy-prod.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "chart.js": "^4.6.1",
    "dockerode": "^5.0.1",
    "next": "16.4.6",
    "otplib": "^13.6.0",
    "pg-boss": "^12.38.2",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "argon2@0.45.2": true,
    "argon2": true
  }
}
