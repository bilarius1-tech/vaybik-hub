# Скопируйте в .env и заполните. НЕ коммитить .env!

# --- Приложение ---
# Для локального `npm run build` не держите NODE_ENV=development в shell/.env —
# Next 16 падает на prerender /_global-error. Скрипт build сам ставит production.
# Локально: development | Прод: production
NODE_ENV=development
APP_URL=http://localhost:3000/admin
# Окружение для бейджа в шапке: dev | prod
APP_ENV=dev
TZ=Europe/Moscow
# Прод: APP_ENV=prod, APP_URL=https://vaybik.ru/admin

# --- База данных ---
POSTGRES_USER=vaybik
POSTGRES_PASSWORD=
POSTGRES_DB=vaybik_admin
DATABASE_URL=postgresql://vaybik:CHANGE_ME@localhost:5432/vaybik_admin?schema=public

# --- Безопасность ---
# 32 байта base64: openssl rand -base64 32
SESSION_SECRET=
VAULT_MASTER_KEY=
VAULT_KEY_VERSION=1
BACKUP_ENCRYPTION_KEY=

# --- Вход ---
# true (по умолчанию) — 2FA обязательна для OWNER/ADMIN; false — по желанию
# (пользователи с включённой 2FA всё равно вводят код)
REQUIRE_2FA=true
# «Запомнить меня» на странице входа: срок скользящей сессии в днях (без галочки — 12 ч)
SESSION_REMEMBER_DAYS=30

# --- Docker (через docker-socket-proxy, не сырой сокет) ---
DOCKER_HOST=tcp://docker-proxy:2375

# --- Traefik (факты сервера) ---
# Внешняя сеть: proxy. Entrypoints: web (http), websecure (https).
# Certresolver: le. Редирект http→https: middleware to-https@docker.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_CERTRESOLVER=le
TRAEFIK_HTTPS_REDIRECT_MIDDLEWARE=to-https@docker
TRAEFIK_ADMIN_HOST=vaybik.ru
# Приоритет роутера /admin выше заглушки nginx
TRAEFIK_ADMIN_PRIORITY=100

# --- Telegram (предпочтительно запись vault kind=telegram_bot; env — фолбэк) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- Uploads / бэкапы (в Docker — /app/uploads и /app/backups) ---
UPLOADS_DIR=
BACKUPS_DIR=
# Прод (хост): каталог bind-mount → /app/backups. По умолчанию /var/backups/vaybik (uid 1001, chmod 700).
BACKUPS_HOST_DIR=/var/backups/vaybik

# --- Тема по умолчанию: A | B | C (выбран вариант A) ---
NEXT_PUBLIC_THEME_VARIANT=A

# --- CMS: origin CSS/fonts/img для предпросмотра страниц ---
# Прод: https://vaybik.ru (публичная статика leadweb). В dev тоже можно указать прод.
SITE_ASSETS_ORIGIN=https://vaybik.ru
