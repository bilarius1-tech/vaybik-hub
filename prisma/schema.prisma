generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PARTNER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String
  role          Role         @default(ADMIN)
  totpSecretEnc String?
  totpEnabled   Boolean      @default(false)
  /// Связь с Partner появится в Фазе 4
  partnerId     String?
  isBlocked     Boolean      @default(false)
  sessions      Session[]
  backupCodes   BackupCode[]
  pagesUpdated  Page[]       @relation("PageUpdatedBy")
  createdAt     DateTime     @default(now())
  lastLoginAt   DateTime?
}

model Session {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  ip          String?
  userAgent   String?
  reauthUntil DateTime?
  /// «Запомнить меня»: срок SESSION_REMEMBER_DAYS вместо 12 ч
  remember    Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  role      Role
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?
}

model PendingLogin {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  remember  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Счётчик неудачных попыток входа (ключ = email:... или ip:...)
model LoginAttempt {
  id           String    @id @default(cuid())
  key          String    @unique
  failedCount  Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

enum ServiceType {
  DOCKER
  EXTERNAL
  STATIC
}

enum CheckStatus {
  UP
  DOWN
  DEGRADED
  UNKNOWN
}

model Service {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  url            String
  description    String?
  icon           String?
  type           ServiceType  @default(DOCKER)
  containerNames String[]
  composeProject String?
  repoUrl        String?
  branch         String?      @default("main")
  healthUrl      String?
  expectedStatus Int          @default(200)
  keyword        String?
  intervalSec    Int          @default(60)
  timeoutMs      Int          @default(10000)
  isPublic       Boolean      @default(false)
  /// false = «не развёрнут» (чат/лид и т.п.)
  isDeployed     Boolean      @default(true)
  sortOrder      Int          @default(0)
  tags           String[]
  status         CheckStatus  @default(UNKNOWN)
  lastCheckedAt  DateTime?
  certExpiresAt  DateTime?
  lastResponseMs Int?
  ownerPartnerId String?
  checks         HealthCheck[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model HealthCheck {
  id         BigInt      @id @default(autoincrement())
  serviceId  String
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     CheckStatus
  httpStatus Int?
  responseMs Int?
  error      String?
  checkedAt  DateTime    @default(now())

  @@index([serviceId, checkedAt])
}

model ServerMetric {
  id        BigInt   @id @default(autoincrement())
  cpu       Float
  memUsed   BigInt
  memTotal  BigInt
  diskUsed  BigInt
  diskTotal BigInt
  load1     Float
  takenAt   DateTime @default(now())

  @@index([takenAt])
}

model NotificationRule {
  id          String   @id @default(cuid())
  event       String
  chatIds     String[]
  isActive    Boolean  @default(true)
  throttleMin Int      @default(10)
  quietStart  String? // HH:mm Europe/Moscow
  quietEnd    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationThrottle {
  id         String   @id @default(cuid())
  key        String   @unique
  lastSentAt DateTime
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model SeoPage {
  id            String   @id @default(cuid())
  host          String   @default("vaybik.ru")
  path          String
  title         String?
  description   String?
  canonical     String?
  robots        String   @default("index,follow")
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  twitterCard   String?  @default("summary_large_image")
  jsonLd        Json?
  inSitemap     Boolean  @default(true)
  priority      Float    @default(0.5)
  changefreq    String   @default("weekly")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  page          Page?

  @@unique([host, path])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NavMenu {
  HEADER
  FOOTER
}

enum RedirectMatch {
  EXACT
  PREFIX
}

/// Страница публичного сайта (черновик блоков в Block; публикация → PageRevision)
model Page {
  id                  String         @id @default(cuid())
  /// Как на сайте: "/", "/uslugi/landing/"
  /// Уникальность активных путей — partial unique index (см. миграцию cms_pages_soft_delete)
  path                String
  title               String
  status              PageStatus     @default(DRAFT)
  /// home | default | service | calculator
  template            String         @default("default")
  sortOrder           Int            @default(0)
  seoPageId           String?        @unique
  seoPage             SeoPage?       @relation(fields: [seoPageId], references: [id], onDelete: SetNull)
  publishedRevisionId String?
  publishedAt         DateTime?
  /// sha256 исходного HTML при импорте
  importHash          String?
  /// manual | import
  source              String         @default("manual")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  updatedById         String?
  updatedBy           User?          @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  /// Soft delete: корзина; null = активна
  deletedAt           DateTime?
  blocks              Block[]
  revisions           PageRevision[]
  navItems            NavItem[]
  mediaUsages         MediaUsage[]

  @@index([deletedAt])
  @@index([updatedAt])
  @@index([status])
  @@index([template])
}

model Block {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  sortOrder Int
  data      Json
  isHidden  Boolean  @default(false)
  /// id секции на странице (например "faq")
  anchor    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mediaUsages MediaUsage[]

  @@index([pageId, sortOrder])
}

model NavItem {
  id            String    @id @default(cuid())
  menu          NavMenu
  parentId      String?
  parent        NavItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      NavItem[] @relation("NavTree")
  label         String
  url           String?
  pageId        String?
  page          Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  sortOrder     Int       @default(0)
  isHidden      Boolean   @default(false)
  isHighlighted Boolean   @default(false)
  openInNewTab  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([menu, sortOrder])
  @@index([parentId])
}

model Redirect {
  id         String        @id @default(cuid())
  fromPath   String        @unique
  toPath     String
  code       Int           @default(301)
  match      RedirectMatch @default(EXACT)
  isActive   Boolean       @default(true)
  hits       Int           @default(0)
  lastHitAt  DateTime?
  note       String?
  /// manual | import
  source     String        @default("manual")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  updatedById String?
}

model PageRevision {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// { page, blocks, seo }
  snapshot    Json
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  mediaUsages MediaUsage[]

  @@index([pageId, createdAt])
}

enum MediaKind {
  IMAGE
  SVG
  GIF
}

model MediaFolder {
  id        String       @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder? @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("MediaFolderTree")
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  assets    MediaAsset[]

  @@index([parentId])
}

model MediaAsset {
  id           String        @id @default(cuid())
  kind         MediaKind
  folderId     String?
  folder       MediaFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         String[]
  originalName String
  title        String?
  alt          String?
  caption      String?
  mime         String
  ext          String
  size         Int
  width        Int?
  height       Int?
  sha256       String        @unique
  version      Int           @default(1)
  /// [{ name, w, h, file, size, mime }]
  variants     Json
  uploadedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  usages       MediaUsage[]

  @@index([folderId])
  @@index([kind])
  @@index([deletedAt])
}

model MediaUsage {
  id         String        @id @default(cuid())
  mediaId    String
  media      MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  pageId     String
  page       Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockId    String?
  block      Block?        @relation(fields: [blockId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   PageRevision? @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// Путь поля: "people.1.photo" или "html"
  field      String

  @@index([mediaId])
  @@index([blockId])
  @@index([pageId])
  @@index([revisionId])
}

model Secret {
  id          String   @id @default(cuid())
  title       String
  kind        String // login | api_key | note | db | ssh | telegram_bot
  url         String?
  username    String?
  folder      String?
  tags        String[]
  note        String? // несекретная заметка (plain)
  dataEnc     Bytes // AES-256-GCM(JSON секретных полей, DEK)
  dataIv      Bytes
  dataTag     Bytes
  dekEnc      Bytes // AES-256-GCM(DEK, MASTER_KEY)
  dekIv       Bytes
  dekTag      Bytes
  keyVersion  Int      @default(1)
  createdById String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([folder])
  @@index([kind])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
}

/// Подключение к Postgres (админка или сервис). Пароль — в Vault (secretId) или env для isSystem.
model DbConnection {
  id              String           @id @default(cuid())
  /// Уникальный ключ каталога файлов: admin | … 
  slug            String           @unique
  name            String
  /// postgres (mysql — задел, пока не поддерживаем)
  engine          String           @default("postgres")
  host            String
  port            Int              @default(5432)
  database        String
  /// Vault kind=db; null у системной БД админки (пароль из DATABASE_URL)
  secretId        String?
  /// Своя БД админки из DATABASE_URL — не удалять, не сеять dev в прод
  isSystem        Boolean          @default(false)
  /// cron, Europe/Moscow; null = только вручную / общий admin-backup
  backupSchedule  String?
  retention       Int              @default(14)
  /// Задел S3/Yandex Object Storage (выключено). Пример: { enabled: false, endpoint, bucket, prefix }
  externalStorage Json?
  lastSizeBytes   BigInt?
  lastTableCount  Int?
  lastPgVersion   String?
  lastInspectedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  backups         Backup[]
  sizeSnapshots   DbSizeSnapshot[]

  @@index([engine])
}

/// Снимки размера для графика роста
model DbSizeSnapshot {
  id             String       @id @default(cuid())
  dbConnectionId String
  dbConnection   DbConnection @relation(fields: [dbConnectionId], references: [id], onDelete: Cascade)
  sizeBytes      BigInt
  takenAt        DateTime     @default(now())

  @@index([dbConnectionId, takenAt])
}

model Backup {
  id             String        @id @default(cuid())
  dbConnectionId String?
  dbConnection   DbConnection? @relation(fields: [dbConnectionId], references: [id], onDelete: SetNull)
  /// admin-db | uploads | connection
  target         String
  /// manual | schedule | verify
  trigger        String
  file           String
  checksumSha256 String?
  sizeBytes      BigInt?
  /// pending | running | ok | error | verified
  status         String        @default("pending")
  /// Без секретов / URI
  error          String?
  createdById    String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([dbConnectionId, startedAt])
  @@index([status])
  @@index([startedAt])
}
