generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PARTNER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String
  role          Role         @default(ADMIN)
  totpSecretEnc String?
  totpEnabled   Boolean      @default(false)
  /// Связь с Partner появится в Фазе 4
  partnerId     String?
  isBlocked     Boolean      @default(false)
  sessions      Session[]
  backupCodes   BackupCode[]
  createdAt     DateTime     @default(now())
  lastLoginAt   DateTime?
}

model Session {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  ip          String?
  userAgent   String?
  reauthUntil DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  role      Role
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?
}

model PendingLogin {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Счётчик неудачных попыток входа (ключ = email:... или ip:...)
model LoginAttempt {
  id           String    @id @default(cuid())
  key          String    @unique
  failedCount  Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
}
