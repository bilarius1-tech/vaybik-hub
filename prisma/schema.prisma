generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PARTNER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String
  role          Role         @default(ADMIN)
  totpSecretEnc String?
  totpEnabled   Boolean      @default(false)
  /// Связь с Partner появится в Фазе 4
  partnerId     String?
  isBlocked     Boolean      @default(false)
  sessions      Session[]
  backupCodes   BackupCode[]
  createdAt     DateTime     @default(now())
  lastLoginAt   DateTime?
}

model Session {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  ip          String?
  userAgent   String?
  reauthUntil DateTime?
  /// «Запомнить меня»: срок SESSION_REMEMBER_DAYS вместо 12 ч
  remember    Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  role      Role
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?
}

model PendingLogin {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  remember  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Счётчик неудачных попыток входа (ключ = email:... или ip:...)
model LoginAttempt {
  id           String    @id @default(cuid())
  key          String    @unique
  failedCount  Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

enum ServiceType {
  DOCKER
  EXTERNAL
  STATIC
}

enum CheckStatus {
  UP
  DOWN
  DEGRADED
  UNKNOWN
}

model Service {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  url            String
  description    String?
  icon           String?
  type           ServiceType  @default(DOCKER)
  containerNames String[]
  composeProject String?
  repoUrl        String?
  branch         String?      @default("main")
  healthUrl      String?
  expectedStatus Int          @default(200)
  keyword        String?
  intervalSec    Int          @default(60)
  timeoutMs      Int          @default(10000)
  isPublic       Boolean      @default(false)
  /// false = «не развёрнут» (чат/лид и т.п.)
  isDeployed     Boolean      @default(true)
  sortOrder      Int          @default(0)
  tags           String[]
  status         CheckStatus  @default(UNKNOWN)
  lastCheckedAt  DateTime?
  certExpiresAt  DateTime?
  lastResponseMs Int?
  ownerPartnerId String?
  checks         HealthCheck[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model HealthCheck {
  id         BigInt      @id @default(autoincrement())
  serviceId  String
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     CheckStatus
  httpStatus Int?
  responseMs Int?
  error      String?
  checkedAt  DateTime    @default(now())

  @@index([serviceId, checkedAt])
}

model ServerMetric {
  id        BigInt   @id @default(autoincrement())
  cpu       Float
  memUsed   BigInt
  memTotal  BigInt
  diskUsed  BigInt
  diskTotal BigInt
  load1     Float
  takenAt   DateTime @default(now())

  @@index([takenAt])
}

model NotificationRule {
  id          String   @id @default(cuid())
  event       String
  chatIds     String[]
  isActive    Boolean  @default(true)
  throttleMin Int      @default(10)
  quietStart  String? // HH:mm Europe/Moscow
  quietEnd    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationThrottle {
  id         String   @id @default(cuid())
  key        String   @unique
  lastSentAt DateTime
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model SeoPage {
  id            String   @id @default(cuid())
  host          String   @default("vaybik.ru")
  path          String
  title         String?
  description   String?
  canonical     String?
  robots        String   @default("index,follow")
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  twitterCard   String?  @default("summary_large_image")
  jsonLd        Json?
  inSitemap     Boolean  @default(true)
  priority      Float    @default(0.5)
  changefreq    String   @default("weekly")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([host, path])
}

model Secret {
  id          String   @id @default(cuid())
  title       String
  kind        String // login | api_key | note | db | ssh | telegram_bot
  url         String?
  username    String?
  folder      String?
  tags        String[]
  note        String? // несекретная заметка (plain)
  dataEnc     Bytes // AES-256-GCM(JSON секретных полей, DEK)
  dataIv      Bytes
  dataTag     Bytes
  dekEnc      Bytes // AES-256-GCM(DEK, MASTER_KEY)
  dekIv       Bytes
  dekTag      Bytes
  keyVersion  Int      @default(1)
  createdById String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([folder])
  @@index([kind])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
}
